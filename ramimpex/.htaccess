# RAM IMPEX — always serve fresh HTML after deploys (no stale cache)

# Force HTTPS (SSL active). Exclude ACME challenge so AutoSSL renewals keep working.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
</IfModule>

# Browsers/proxies: never cache HTML (static assets in /img can still cache)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # images/fonts can cache for a week
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# LiteSpeed: do not page-cache this static site (prevents stale HTML)
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

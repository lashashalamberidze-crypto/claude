# gverdshi.ge — cache policy
# HTML ყოველთვის განახლდეს (რომ ახალი ვერსია მაშინვე მოვიდეს), asset-ები კი დაქეშდეს

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  # სტატიკური asset-ები — გრძელი ქეში (სიჩქარისთვის)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|woff2|woff|ttf|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
